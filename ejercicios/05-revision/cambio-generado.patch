+/**
+ * Renew a loan.
+ */
+export function renewLoan(db, { isbn, memberId }) {
+  const loan = db.loans.find((l) => l.isbn === isbn && l.memberId === memberId);
+  if (!loan) {
+    throw new Error("Loan not found");
+  }
+  const due = new Date(loan.dueDate);
+  due.setUTCDate(due.getUTCDate() + 14);
+  loan.dueDate = due.toISOString().slice(0, 10);
+  loan.renewed = true;
+  return db;
+}
